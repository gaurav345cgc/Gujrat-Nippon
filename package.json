{
  "name": "corporate-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx scripts/seed-supabase-admin.ts",
    "db:seed:brochures": "npx tsx scripts/seed-brochures.ts",
    "db:setup:storage": "npx tsx scripts/ensure-storage-buckets.ts",
    "db:seed:faqs": "npx tsx scripts/seed-faqs.ts",
    "test": "node --import tsx --test tests/faqs/validate.test.ts tests/faqs/sanitize.test.ts tests/admin/csv.test.ts",
    "test:faqs": "node --import tsx --test tests/faqs/validate.test.ts tests/faqs/sanitize.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.35.0",
    "lenis": "^1.3.18",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.19.0",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
